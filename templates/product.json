/*
 * Shopify product template.
 */
{
  "sections": {
    "main": {
      "type": "product",
      "settings": {},
      "blocks": {
        "vendor": {
          "type": "vendor",
          "settings": {}
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "variants": {
          "type": "variant_picker",
          "settings": {
            "label": "Choose an option"
          }
        },
        "quantity": {
          "type": "quantity",
          "settings": {}
        },
        "buy": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true
          }
        },
        "shipping": {
          "type": "collapsible",
          "settings": {
            "heading": "Shipping & care",
            "content": "<p>Shipping information and growing guidance will appear here.</p>"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "description",
        "variants",
        "quantity",
        "buy",
        "shipping"
      ]
    }
  },
  "order": [
    "main"
  ]
}
