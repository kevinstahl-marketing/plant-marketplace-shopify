<div
  class="category-shortcuts theme-block category-shortcuts--{{ block.settings.style }}"
  style="
    --shortcut-gap: {{ block.settings.gap }}px;
    --shortcut-radius: {{ block.settings.radius }}px;
    --shortcut-image-size: {{ block.settings.image_size }}px;
    --shortcut-align: {{ block.settings.alignment }};
    --block-width: 100%;
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <span class="category-shortcuts__heading">
      {{ block.settings.heading | escape }}
    </span>
  {% endif %}

  <div class="category-shortcuts__items">
    {% for i in (1..6) %}
      {% assign collection_key = 'collection_' | append: i %}
      {% assign label_key = 'label_' | append: i %}
      {% assign image_key = 'image_' | append: i %}
      {% assign link_key = 'link_' | append: i %}

      {% assign shortcut_collection = block.settings[collection_key] %}
      {% assign shortcut_label = block.settings[label_key] %}
      {% assign shortcut_image = block.settings[image_key] %}
      {% assign shortcut_link = block.settings[link_key] %}

      {% if shortcut_collection != blank %}
        {% if shortcut_label == blank %}
          {% assign shortcut_label = shortcut_collection.title %}
        {% endif %}
        {% if shortcut_image == blank %}
          {% assign shortcut_image = shortcut_collection.featured_image %}
        {% endif %}
        {% if shortcut_link == blank %}
          {% assign shortcut_link = shortcut_collection.url %}
        {% endif %}
      {% endif %}

      {% if shortcut_label != blank and shortcut_link != blank %}
        <a class="category-shortcuts__item" href="{{ shortcut_link }}">
          {% if block.settings.style != 'text' %}
            {% if shortcut_image != blank %}
              <span class="category-shortcuts__media">
                {{
                  shortcut_image
                  | image_url: width: 400
                  | image_tag:
                    class: 'category-shortcuts__image',
                    loading: 'lazy',
                    widths: '80, 120, 160, 240, 400',
                    sizes: '(max-width: 749px) 120px, 160px',
                    alt: shortcut_label
                }}
              </span>
            {% elsif block.settings.style == 'cards' %}
              <span class="category-shortcuts__media category-shortcuts__media--empty">
                {{ 'image' | placeholder_svg_tag }}
              </span>
            {% endif %}
          {% endif %}

          <span class="category-shortcuts__label">
            {{ shortcut_label | escape }}
          </span>

          {% unless block.settings.style == 'cards' %}
            <span class="category-shortcuts__arrow" aria-hidden="true">↗</span>
          {% endunless %}
        </a>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
.category-shortcuts {
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-width: 0;
}

.category-shortcuts__heading {
  font-size: .75rem;
  font-weight: 600;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.category-shortcuts__items {
  display: flex;
  flex-wrap: wrap;
  justify-content: var(--shortcut-align, flex-start);
  gap: var(--shortcut-gap, 8px);
  min-width: 0;
}

.category-shortcuts__item {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  min-height: 44px;
  padding: 5px 14px 5px 5px;
  border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  border-radius: var(--shortcut-radius, 24px);
  background: color-mix(in srgb, var(--color-background) 55%, transparent);
  color: inherit;
  font-size: .8125rem;
  line-height: 1.3;
  text-decoration: none;
  transition: transform 180ms ease, background 180ms ease;
}

.category-shortcuts__item:hover {
  transform: translateY(-2px);
  background: color-mix(in srgb, var(--color-background) 80%, transparent);
}

.category-shortcuts__item:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 3px;
}

.category-shortcuts__media {
  display: block;
  width: var(--shortcut-image-size, 36px);
  height: var(--shortcut-image-size, 36px);
  flex: none;
  overflow: hidden;
  border-radius: max(0px, calc(var(--shortcut-radius, 24px) - 5px));
  background: var(--color-surface);
}

.category-shortcuts__image,
.category-shortcuts__media svg {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.category-shortcuts__label {
  min-width: 0;
  overflow-wrap: anywhere;
  font-weight: 500;
}

.category-shortcuts__arrow {
  flex: none;
  opacity: .65;
}

/* Mini cards */
.category-shortcuts--cards .category-shortcuts__items {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.category-shortcuts--cards .category-shortcuts__item {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 10px;
  min-height: 0;
  padding: 8px;
}

.category-shortcuts--cards .category-shortcuts__media {
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 3;
  border-radius: max(0px, calc(var(--shortcut-radius, 24px) - 8px));
}

.category-shortcuts--cards .category-shortcuts__label {
  padding: 0 5px 5px;
}

/* Text pills */
.category-shortcuts--text .category-shortcuts__item {
  padding: 9px 15px;
}

@media (max-width: 749px) {
  .category-shortcuts--cards .category-shortcuts__items {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (prefers-reduced-motion: reduce) {
  .category-shortcuts__item {
    transition: none;
  }
}
{% endstylesheet %}

