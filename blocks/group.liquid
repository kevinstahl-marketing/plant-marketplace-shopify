      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "material",
      "label": "Material",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "default",
          "label": "Global glass"
        },
        {
          "value": "clear",
          "label": "Clear"
        },
        {
          "value": "mist",
          "label": "Mist"
        },
        {
          "value": "cloudlight",
          "label": "Cloudlight"
        },
        {
          "value": "canopy",
          "label": "Canopy"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "custom_glass",
      "label": "Override glass settings",
      "default": false,
      "visible_if": "{{ block.settings.material != 'none' }}"
    },
    {
      "type": "range",
      "id": "opacity",
      "label": "Glass opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85,
      "visible_if": "{{ block.settings.custom_glass }}"
    },
    {
      "type": "range",
      "id": "blur",
      "label": "Glass blur",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.custom_glass }}"
    }
  ],
  "presets": [
    {
      "name": "Group",
      "category": "Layout"
    }
  ]
}
{% endschema %}
