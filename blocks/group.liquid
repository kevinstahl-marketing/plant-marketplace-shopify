<div
  class="theme-group{% if block.settings.material != 'none' %} glass-surface glass-surface--{{ block.settings.material }}{% endif %}"
  style="
    --group-direction: {{ block.settings.direction }};
    --group-mobile-direction: {{ block.settings.mobile_direction }};
    --group-mobile-align: {{ block.settings.mobile_alignment }};
    --group-gap: {{ block.settings.gap }}px;
    --group-mobile-gap: {{ block.settings.mobile_gap }}px;
    --group-wrap: {{ block.settings.wrap }};
    --group-max-width: {{ block.settings.max_width }}px;
    --group-min-height: {{ block.settings.min_height }}px;
    --group-padding-x: {{ block.settings.padding_x }}px;
    --group-padding-y: {{ block.settings.padding_y }}px;
    --group-mobile-padding-x: {{ block.settings.mobile_padding_x }}px;
    --group-mobile-padding-y: {{ block.settings.mobile_padding_y }}px;
    --group-align: {{ block.settings.alignment }};
    --group-justify: {{ block.settings.justify }};
    --group-width: {{ block.settings.width }}%;
    --group-radius: {{ block.settings.radius }}px;
    --glass-radius-override: {{ block.settings.radius }}px;
    {% if block.settings.custom_glass %}
      --glass-opacity-override: {{ block.settings.opacity }}%;
      --glass-blur-override: {{ block.settings.blur }}px;
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
.theme-group {
  display: flex;
  flex-direction: var(--group-direction, column);
  flex-wrap: var(--group-wrap, nowrap);
  align-items: var(--group-align, stretch);
  justify-content: var(--group-justify, flex-start);
  gap: var(--group-gap, 16px);
  width: var(--group-width, 100%);
  max-width: min(100%, var(--group-max-width, 1200px));
  min-width: 0;
  min-height: var(--group-min-height, 0px);
  padding:
    var(--group-padding-y, 24px)
    var(--group-padding-x, 24px);
  border-radius: var(--group-radius, 12px);
  box-sizing: border-box;
}

.theme-group > * {
  min-width: 0;
  max-width: 100%;
}

@media (max-width: 749px) {
  .theme-group {
    flex-direction: var(--group-mobile-direction, column);
    align-items: var(--group-mobile-align, stretch);
    gap: var(--group-mobile-gap, 16px);
    padding:
      var(--group-mobile-padding-y, 24px)
      var(--group-mobile-padding-x, 20px);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Group",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "column",
          "label": "Vertical"
        },
        {
          "value": "row",
          "label": "Horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Align children",
      "options": [
        {
          "value": "flex-start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "End"
        },
        {
          "value": "stretch",
          "label": "Stretch"
        }
      ],
      "default": "stretch"
    },
    {
      "type": "select",
      "id": "justify",
      "label": "Distribute children",
      "options": [
        {
          "value": "flex-start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "End"
        },
        {
          "value": "space-between",
          "label": "Space between"
        },
        {
          "value": "space-around",
          "label": "Space around"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "wrap",
      "label": "Wrapping",
      "options": [
        {
          "value": "nowrap",
          "label": "No wrap"
        },
        {
          "value": "wrap",
          "label": "Wrap"
        }
      ],
      "default": "nowrap"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "width",
      "label": "Width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 300,
      "max": 1500,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_direction",
      "label": "Mobile direction",
      "options": [
        {
          "value": "column",
          "label": "Vertical"
        },
        {
          "value": "row",
          "label": "Horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Mobile align children",
      "options": [
        {
          "value": "stretch",
          "label": "Stretch"
        },
        {
          "value": "flex-start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "End"
        }
      ],
      "default": "stretch"
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_padding_x",
      "label": "Mobile horizontal padding",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 20
