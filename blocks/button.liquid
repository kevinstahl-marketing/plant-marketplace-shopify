{% if block.settings.label != blank %}
  <a
    class="theme-button theme-block theme-button--{{ block.settings.style }}"
    href="{{ block.settings.link | default: routes.all_products_collection_url }}"
    style="
    --block-width: {{ block.settings.block_width | default: 'fit-content' }};
    --block-position: {{ block.settings.block_position | default: 'auto' }};
    --block-mobile-width: {{ block.settings.mobile_block_width | default: 'fit-content' }};
    --block-mobile-position: {{ block.settings.mobile_block_position | default: 'auto' }};
"
    {{ block.shopify_attributes }}
  >
    {{ block.settings.label | escape }}
  </a>
{% endif %}

{% stylesheet %}
.theme-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 24px;
  border: 1px solid currentColor;
  border-radius: var(--radius-sm);
  text-decoration: none;
  font-weight: 600;
  transition: opacity var(--transition-fast);
}
.theme-button:hover { opacity: .8; }
.theme-button--primary {
  background: var(--color-primary);
  color: var(--color-background);
  border-color: var(--color-primary);
}
.theme-button--secondary {
  background: var(--color-surface);
  color: var(--color-text);
  border-color: var(--color-border);
}
.theme-button--outline {
  background: transparent;
  color: inherit;
}
.theme-button--link {
  background: transparent;
  border: 0;
  padding-inline: 0;
  text-decoration: underline;
  text-underline-offset: 5px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Button",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Explore collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "link",
          "label": "Text link"
        }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Block layout"
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Width",
      "options": [
        {
          "value": "100%",
          "label": "Fill available width"
        },
        {
          "value": "fit-content",
          "label": "Fit content"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "select",
      "id": "block_position",
      "label": "Block alignment",
      "options": [
        {
          "value": "auto",
          "label": "Use parent"
        },
        {
          "value": "flex-start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "End"
        }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_block_width",
      "label": "Mobile width",
      "options": [
        {
          "value": "100%",
          "label": "Fill available width"
        },
        {
          "value": "fit-content",
          "label": "Fit content"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "select",
      "id": "mobile_block_position",
      "label": "Mobile block alignment",
      "options": [
        {
          "value": "auto",
          "label": "Use parent"
        },
        {
          "value": "flex-start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "End"
        }
      ],
      "default": "auto"
    }
  ],
  "presets": [
    {
      "name": "Button",
      "category": "Actions"
    }
  ]
}
{% endschema %}
