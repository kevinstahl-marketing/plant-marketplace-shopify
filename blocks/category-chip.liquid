{% liquid
  assign chip_collection = block.settings.collection
  assign chip_label = block.settings.label
  assign chip_image = block.settings.image
  assign chip_link = block.settings.link

  if chip_collection != blank
    if chip_label == blank
      assign chip_label = chip_collection.title
    endif

    if chip_image == blank
      assign chip_image = chip_collection.featured_image
    endif

    if chip_link == blank
      assign chip_link = chip_collection.url
    endif
  endif
%}

{% if chip_label != blank and chip_link != blank %}
  <a
    class="category-chip theme-block category-chip--{{ block.settings.style }}"
    href="{{ chip_link }}"
    style="
      --chip-radius: {{ block.settings.radius }}px;
      --chip-image-size: {{ block.settings.image_size }}px;
      --block-width: fit-content;
      --block-mobile-width: fit-content;
    "
    {{ block.shopify_attributes }}
  >
    {% if block.settings.style == 'image' and chip_image != blank %}
      <span class="category-chip__media">
        {{
          chip_image
          | image_url: width: 160
          | image_tag:
            class: 'category-chip__image',
            loading: 'lazy',
            widths: '64, 96, 128, 160',
            sizes: '64px',
            alt: chip_label
        }}
      </span>
    {% endif %}

    <span class="category-chip__label">
      {{ chip_label | escape }}
    </span>

    {% if block.settings.show_arrow %}
      <span class="category-chip__arrow" aria-hidden="true">
        ↗
      </span>
    {% endif %}
  </a>
{% endif %}

{% stylesheet %}
.category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  flex: 0 1 auto;
  gap: 9px;

  min-width: 0;
  max-width: 100%;
  min-height: 44px;

  padding: 5px 13px 5px 5px;

  border: 1px solid color-mix(
    in srgb,
    currentColor 18%,
    transparent
  );

  border-radius: var(--chip-radius, 48px);

  background: color-mix(
    in srgb,
    var(--color-background) 55%,
    transparent
  );

  color: inherit;
  font-family: var(--font-body);
  font-size: .8125rem;
  line-height: 1.3;
  text-decoration: none;

  transition:
    transform 180ms ease,
    background 180ms ease;
}

.category-chip:hover {
  transform: translateY(-2px);

  background: color-mix(
    in srgb,
    var(--color-background) 80%,
    transparent
  );
}

.category-chip:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 3px;
}

.category-chip__media {
  display: block;
  width: var(--chip-image-size, 36px);
  height: var(--chip-image-size, 36px);
  flex: none;
  overflow: hidden;

  border-radius: max(
    0px,
    calc(var(--chip-radius, 48px) - 5px)
  );

  background: var(--color-surface);
}

.category-chip__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.category-chip__label {
  min-width: 0;
  overflow-wrap: anywhere;
  font-weight: 500;
}

.category-chip__arrow {
  flex: none;
  opacity: .65;
}

.category-chip--text {
  padding: 9px 14px;
}

@media (max-width: 749px) {
  .category-chip {
    font-size: .78rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .category-chip {
    transition: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Category Chip",
  "settings": [
    {
      "type": "header",
      "content": "Category"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Custom label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom image",
      "visible_if": "{{ block.settings.style == 'image' }}"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Custom destination"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "image",
          "label": "Image chip"
        },
        {
          "value": "text",
          "label": "Text chip"
        }
      ],
      "default": "image"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Image size",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 36,
      "visible_if": "{{ block.settings.style == 'image' }}"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner rounding",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Category Chip",
      "category": "Navigation"
    }
  ]
}
{% endschema %}
