<div
  class="theme-image theme-block"
  style="
    --image-ratio: {{ block.settings.ratio }};
    --block-width: {{ block.settings.block_width | default: '100%' }};
    --block-position: {{ block.settings.block_position | default: 'auto' }};
    --block-mobile-width: {{ block.settings.mobile_block_width | default: '100%' }};
    --block-mobile-position: {{ block.settings.mobile_block_position | default: 'auto' }};

    --image-radius: {{ block.settings.radius }}px;
    --image-position: {{ block.settings.position }};
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.image != blank %}
    {% if block.settings.link != blank %}
      <a href="{{ block.settings.link }}">
    {% endif %}

    {{
      block.settings.image
      | image_url: width: 1600
      | image_tag:
        loading: 'lazy',
        widths: '320, 480, 750, 1000, 1600',
        class: 'theme-image__media'
    }}

    {% if block.settings.link != blank %}
      </a>
    {% endif %}
  {% else %}
    {{ 'image' | placeholder_svg_tag: 'theme-image__media' }}
  {% endif %}
</div>

{% stylesheet %}
.theme-image {
  aspect-ratio: var(--image-ratio);
  border-radius: var(--image-radius);
  overflow: hidden;
}
.theme-image a { display: block; width: 100%; height: 100%; }
.theme-image__media {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: var(--image-position);
}
{% endstylesheet %}

{% schema %}
{
  "name": "Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "value": "1",
          "label": "Square"
        },
        {
          "value": "0.8",
          "label": "Portrait"
        },
        {
          "value": "1.5",
          "label": "Landscape"
        },
        {
          "value": "1.777",
          "label": "Wide"
        }
      ],
      "default": "1.5"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Focal point",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Block layout"
    },
    {
      "type": "select",
      "id": "block_width",
      "label": "Width",
      "options": [
        {
          "value": "100%",
          "label": "Fill available width"
        },
        {
          "value": "fit-content",
          "label": "Fit content"
        }
      ],
      "default": "100%"
    },
    {
      "type": "select",
      "id": "block_position",
      "label": "Block alignment",
      "options": [
        {
          "value": "auto",
          "label": "Use parent"
        },
        {
          "value": "flex-start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "End"
        }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_block_width",
      "label": "Mobile width",
      "options": [
        {
          "value": "100%",
          "label": "Fill available width"
        },
        {
          "value": "fit-content",
          "label": "Fit content"
        }
      ],
      "default": "100%"
    },
    {
      "type": "select",
      "id": "mobile_block_position",
      "label": "Mobile block alignment",
      "options": [
        {
          "value": "auto",
          "label": "Use parent"
        },
        {
          "value": "flex-start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "End"
        }
      ],
      "default": "auto"
    }
  ],
  "presets": [
    {
      "name": "Image",
      "category": "Media"
    }
  ]
}
{% endschema %}
