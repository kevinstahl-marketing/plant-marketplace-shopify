<div
  class="theme-image"
  style="
    --image-ratio: {{ block.settings.ratio }};
    --image-radius: {{ block.settings.radius }}px;
    --image-position: {{ block.settings.position }};
  "
  {{ block.shopify_attributes }}
>
  {% if block.settings.image != blank %}
    {% if block.settings.link != blank %}
      <a href="{{ block.settings.link }}">
    {% endif %}

    {{
      block.settings.image
      | image_url: width: 1600
      | image_tag:
        loading: 'lazy',
        widths: '320, 480, 750, 1000, 1600',
        class: 'theme-image__media'
    }}

    {% if block.settings.link != blank %}
      </a>
    {% endif %}
  {% else %}
    {{ 'image' | placeholder_svg_tag: 'theme-image__media' }}
  {% endif %}
</div>

{% stylesheet %}
.theme-image {
  width: 100%;
  aspect-ratio: var(--image-ratio);
  border-radius: var(--image-radius);
  overflow: hidden;
}
.theme-image a { display: block; width: 100%; height: 100%; }
.theme-image__media {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: var(--image-position);
}
{% endstylesheet %}

{% schema %}
{
  "name": "Image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Aspect ratio",
      "options": [
        {"value": "1", "label": "Square"},
        {"value": "0.8", "label": "Portrait"},
        {"value": "1.5", "label": "Landscape"},
        {"value": "1.777", "label": "Wide"}
      ],
      "default": "1.5"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Focal point",
      "options": [
        {"value": "center", "label": "Center"},
        {"value": "top", "label": "Top"},
        {"value": "bottom", "label": "Bottom"},
        {"value": "left", "label": "Left"},
        {"value": "right", "label": "Right"}
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [{"name": "Image", "category": "Media"}]
}
{% endschema %}
