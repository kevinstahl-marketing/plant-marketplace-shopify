<div
  class="theme-text"
  style="
    --text-size: {{ block.settings.size }}px;
    --text-align: {{ block.settings.alignment }};
  "
  {{ block.shopify_attributes }}
>
  {{ block.settings.text }}
</div>

{% stylesheet %}
.theme-text {
  font-family: var(--font-body);
  font-size: var(--text-size);
  line-height: 1.65;
  text-align: var(--text-align);
  color: inherit;
}
.theme-text p:first-child { margin-top: 0; }
.theme-text p:last-child { margin-bottom: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "Text",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Discover plants, seeds, and everything worth growing.</p>"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alignment",
      "default": "left"
    }
  ],
  "presets": [{"name": "Text", "category": "Text"}]
}
{% endschema %}
