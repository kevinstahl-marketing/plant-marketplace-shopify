{{ 'discovery-hero.css' | asset_url | stylesheet_tag }}

<section
  class="discovery-hero color-{{ section.settings.color_scheme }} discovery-hero--{{ section.settings.hero_layout | default: 'immersive' }}"
  style="
    --hero-min-height: {{ section.settings.hero_height }}px;
    --hero-image-position: {{ section.settings.image_position }};
    --hero-overlay-strength: {{ section.settings.hero_overlay | default: 15 }}%;
  "
>
  <div class="discovery-hero__layout">
    <div class="discovery-hero__content{% if section.settings.hero_layout == 'immersive' %} glass-surface glass-surface--{{ section.settings.hero_glass | default: 'default' }}{% endif %}">
      {% if section.settings.eyebrow != blank %}
        <p class="discovery-hero__eyebrow">
          <span class="discovery-hero__eyebrow-mark" aria-hidden="true">✳</span>
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="discovery-hero__heading">
          {{ section.settings.heading | escape }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="discovery-hero__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <div class="discovery-hero__search">
        {% render 'search-form',
          context: 'hero',
          placeholder: section.settings.search_placeholder,
          show_button: true
        %}
      </div>

      {% if section.blocks.size > 0 %}
        <div class="discovery-hero__discover">
          <span class="discovery-hero__discover-label">EXPLORE</span>
          <div class="discovery-hero__links">
            {% for block in section.blocks %}
              {% if block.settings.label != blank and block.settings.link != blank %}
                <a
                  class="discovery-hero__link glass-surface glass-surface--default"
                  href="{{ block.settings.link }}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.label | escape }}
                  <span aria-hidden="true">↗</span>
                </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <a
          class="discovery-hero__cta"
          href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}"
        >
          {{ section.settings.cta_label | escape }}
          <span aria-hidden="true">↗</span>
        </a>
      {% endif %}
    </div>

    <div class="discovery-hero__visual">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            class: 'discovery-hero__image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '500, 750, 1000, 1400, 1800',
            sizes: '(max-width: 749px) 100vw, 50vw'
        }}
      {% else %}
        <div class="discovery-hero__image-placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>
      {% endif %}

      {% if section.settings.image_caption != blank %}
        <div class="discovery-hero__image-caption">
          <span class="discovery-hero__caption-line"></span>
          {{ section.settings.image_caption | escape }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Discovery hero",
  "tag": "section",
  "class": "discovery-hero-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Editorial content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE BOTANICAL MARKETPLACE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your next obsession."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover extraordinary plants, tropical fruit trees, rare seeds, and everything you need to grow something remarkable.</p>"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search plants, seeds, cultivars..."
    },
    {
      "type": "header",
      "content": "Shopping"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Shop button label",
      "default": "Shop all plants & seeds"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Shop button link"
    },
    {
      "type": "header",
      "content": "Photography"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Image caption",
      "default": "A WORLD WORTH GROWING"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Minimum desktop height",
      "min": 480,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 620
    },
    {
      "type": "header",
      "content": "Greenhouse composition"
    },
    {
      "type": "select",
      "id": "hero_layout",
      "label": "Hero layout",
      "options": [
        {
          "value": "split",
          "label": "Editorial split"
        },
        {
          "value": "immersive",
          "label": "Immersive greenhouse"
        }
      ],
      "default": "immersive"
    },
    {
      "type": "select",
      "id": "hero_glass",
      "label": "Discovery panel glass",
      "options": [
        {
          "value": "default",
          "label": "Use global material"
        },
        {
          "value": "clear",
          "label": "Clear canopy"
        },
        {
          "value": "mist",
          "label": "Morning mist"
        },
        {
          "value": "cloudlight",
          "label": "Cloudlight"
        },
        {
          "value": "canopy",
          "label": "Deep canopy"
        }
      ],
      "default": "cloudlight"
    },
    {
      "type": "range",
      "id": "hero_overlay",
      "label": "Photo overlay strength",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "quick_link",
      "name": "Discovery link",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Explore plants"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Destination"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Discovery hero"
    }
  ]
}
{% endschema %}
