{{ 'discovery-hero.css' | asset_url | stylesheet_tag }}

<section
  class="discovery-hero full-width color-{{ section.settings.color_scheme }} discovery-hero--{{ section.settings.hero_layout | default: 'immersive' }}"
  style="
    --hero-min-height: {{ section.settings.hero_height }}px;
    --hero-mobile-height: {{ section.settings.mobile_height | default: 620 }}px;
    --hero-content-width: {{ section.settings.content_width | default: 740 }}px;
    --hero-content-align: {{ section.settings.content_alignment | default: 'flex-start' }};
    --hero-mobile-content-align: {{ section.settings.mobile_content_alignment | default: 'center' }};
    --hero-mobile-image-position: {{ section.settings.mobile_image_position | default: 'center' }};
    --hero-image-position: {{ section.settings.image_position }};
    --hero-overlay-strength: {{ section.settings.hero_overlay | default: 15 }}%;
  "
>
  <div class="discovery-hero__layout">
    <div class="discovery-hero__content">
      {% content_for 'blocks' %}
    </div>

    <div class="discovery-hero__visual">
      {% if section.settings.image != blank %}
        {% assign hero_image_sizes = '(max-width: 749px) 100vw, 50vw' %}
        {% if section.settings.hero_layout == 'immersive' %}
          {% assign hero_image_sizes = '100vw' %}
        {% endif %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            class: 'discovery-hero__image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '500, 750, 1000, 1400, 1800',
            sizes: hero_image_sizes
        }}
      {% else %}
        <div class="discovery-hero__image-placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>
      {% endif %}

      {% if section.settings.show_image_caption and section.settings.image_caption != blank %}
        <div class="discovery-hero__image-caption">
          <span class="discovery-hero__caption-line"></span>
          {{ section.settings.image_caption | escape }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Discovery hero",
  "tag": "section",
  "class": "discovery-hero-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Photography"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Image caption",
      "default": "A WORLD WORTH GROWING"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Minimum desktop height",
      "min": 480,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 620
    },
    {
      "type": "header",
      "content": "Greenhouse composition"
    },
    {
      "type": "select",
      "id": "hero_layout",
      "label": "Hero layout",
      "options": [
        {
          "value": "split",
          "label": "Editorial split"
        },
        {
          "value": "immersive",
          "label": "Immersive greenhouse"
        }
      ],
      "default": "immersive"
    },
    {
      "type": "range",
      "id": "hero_overlay",
      "label": "Photo overlay strength",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 15
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content max width",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 740
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile minimum height",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 620
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Mobile image position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_image_caption",
      "label": "Show image caption",
      "default": true
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "label": "Mobile panel alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "presets": [
    {
      "name": "Discovery hero"
    }
  ]
}
{% endschema %}
