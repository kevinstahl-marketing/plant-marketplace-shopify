{{ 'controls.css' | asset_url | stylesheet_tag }}
{{ 'carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'carousel.js' | asset_url }}" defer="defer"></script>
{{ 'glass.css' | asset_url | stylesheet_tag }}
{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'featured-products.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-quick-add.js' | asset_url }}" defer="defer"></script>

<section
  id="FeaturedProducts-{{ section.id }}"
  class="featured-products full-width color-{{ section.settings.color_scheme }}"
  data-carousel
  data-heading-alignment="{{ section.settings.heading_alignment }}"
  data-desktop-layout="{{ section.settings.desktop_layout }}"
  data-mobile-layout="{{ section.settings.mobile_layout }}"
  style="
    --carousel-columns: {{ section.settings.columns }};
    --carousel-mobile-columns: {{ section.settings.mobile_columns }};
    --carousel-mobile-visible: {{ section.settings.mobile_visible }};
    --carousel-desktop-peek: {{ section.settings.desktop_peek }}px;
    --carousel-mobile-peek: {{ section.settings.mobile_peek }}px;
    --carousel-gap: {{ section.settings.gap }}px;
    --products-mobile-columns: {{ section.settings.mobile_columns }};
    --products-gap: {{ section.settings.gap }}px;
    --products-padding-top: {{ section.settings.padding_top }}px;
    --products-padding-bottom: {{ section.settings.padding_bottom }}px;
    --product-card-radius: {{ section.settings.card_radius }}px;
  "
>
  <div class="{% if section.settings.full_width %}container-fluid{% else %}container{% endif %}">

    <div class="featured-products__heading{% if section.settings.use_heading_color_scheme %} color-{{ section.settings.heading_color_scheme }} featured-products__heading--separate-scheme{% endif %}">
      <div class="featured-products__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="featured-products__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="featured-products__title">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="featured-products__description">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>

      {% if section.settings.collection != blank and section.settings.show_view_all %}
        <a
          class="featured-products__view-all"
          href="{{ section.settings.collection.url }}"
        >
          View all
          <span aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>


{% assign carousel_track_id = 'ProductsTrack-' | append: section.id %}
{% capture carousel_navigation %}
  {% render 'carousel-controls',
        track_id: carousel_track_id,
        label: 'products',
        style: section.settings.arrow_style,
        shape: section.settings.arrow_shape,
        size: section.settings.arrow_size
      %}
{% endcapture %}

{% if section.settings.show_arrows and section.settings.arrow_placement == 'above' %}
      {{ carousel_navigation }}
    {% endif %}

        <div
      id="ProductsTrack-{{ section.id }}"
      class="featured-products__grid"
      data-carousel-track
      aria-label="Featured products"
    >
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.product_limit %}
          <div class="featured-products__item{% if section.settings.use_card_color_scheme %} color-{{ section.settings.card_color_scheme }}{% endif %}" data-carousel-item>
            {% render 'product-card',
              product: product,
            presentation: section.settings.card_presentation,
            title_lines: section.settings.title_lines,
            description_lines: section.settings.description_lines,
              image_ratio: section.settings.image_ratio,
              appearance: section.settings.card_appearance,
              glass: section.settings.glass,
              glass_material: section.settings.glass_material,
              show_vendor: section.settings.show_vendor,
              show_badges: section.settings.show_badges
            %}
          </div>
        {% else %}
          {% if request.design_mode %}
            <p>No products in the selected collection.</p>
          {% endif %}
        {% endfor %}
      {% elsif request.design_mode %}
        <p>Select a collection to display products.</p>
      {% endif %}
    </div>

    {% if section.settings.show_arrows and section.settings.arrow_placement == 'below' %}
      {{ carousel_navigation }}
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "class": "featured-products-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Content colors"
    },
    {
      "type": "checkbox",
      "id": "use_heading_color_scheme",
      "label": "Use separate heading color scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "heading_color_scheme",
      "label": "Heading color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_card_color_scheme",
      "label": "Use separate card color scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FRESH FROM THE GREENHOUSE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something worth growing."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Meet the plants and growing essentials catching our eye.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Maximum products",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
