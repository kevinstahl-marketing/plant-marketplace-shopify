{{ 'product-card.css' | asset_url | stylesheet_tag }}
{{ 'featured-products.css' | asset_url | stylesheet_tag }}

<section
  id="FeaturedProducts-{{ section.id }}"
  class="featured-products color-{{ section.settings.color_scheme }}"
  style="
    --products-columns: {{ section.settings.columns }};
    --products-mobile-columns: {{ section.settings.mobile_columns }};
    --products-gap: {{ section.settings.gap }}px;
    --products-padding-top: {{ section.settings.padding_top }}px;
    --products-padding-bottom: {{ section.settings.padding_bottom }}px;
    --product-card-radius: {{ section.settings.card_radius }}px;
    --products-padding: {{ section.settings.padding }}px;
  "
>
  <div class="{% if section.settings.full_width %}container-fluid{% else %}container{% endif %}">

    <div class="featured-products__heading">
      <div class="featured-products__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="featured-products__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="featured-products__title">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="featured-products__description">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>

      {% if section.settings.collection != blank %}
        <a
          class="featured-products__view-all"
          href="{{ section.settings.collection.url }}"
        >
          View all
          <span aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>

    <div class="featured-products__grid">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.product_limit %}
          <div class="featured-products__item">
            {% render 'product-card',
              product: product,
              image_ratio: section.settings.image_ratio,
              show_vendor: section.settings.show_vendor,
              show_badges: section.settings.show_badges
            %}
          </div>
        {% else %}
          {% if request.design_mode %}
            <p>No products in the selected collection.</p>
          {% endif %}
        {% endfor %}
      {% elsif request.design_mode %}
        <p>Select a collection to display products.</p>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "class": "featured-products-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FRESH FROM THE GREENHOUSE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something worth growing."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Meet the plants and growing essentials catching our eye.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Maximum products",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full-width content",
      "default": false
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Card spacing",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Product cards"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show sale and sold-out badges",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured products",
      "category": "Products"
    }
  ]
}
{% endschema %}
