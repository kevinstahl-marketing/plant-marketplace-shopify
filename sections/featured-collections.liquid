{% liquid
  assign resolved_style = settings.card_default_style
  assign resolved_darkness = settings.card_overlay_darkness
  assign resolved_radius = settings.card_radius
  assign resolved_hover = settings.card_hover
  assign resolved_vignette = settings.card_vignette

  unless section.settings.use_global_card_settings
    assign resolved_style = section.settings.card_appearance
    assign resolved_darkness = section.settings.overlay_darkness
    assign resolved_radius = section.settings.card_radius

    if section.settings.image_zoom
      assign resolved_hover = 'zoom'
    else
      assign resolved_hover = 'none'
    endif
  endunless
%}

{{ 'featured-collections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'featured-collections.js' | asset_url }}" defer="defer"></script>

<section
  id="FeaturedCollections-{{ section.id }}"
  class="featured-collections color-{{ section.settings.color_scheme }} featured-collections--hover-{{ resolved_hover }}"
  data-featured-carousel
  data-desktop-layout="{{ section.settings.desktop_layout }}"
  data-mobile-layout="{{ section.settings.mobile_layout }}"
  style="
    --featured-mobile-columns: {{ section.settings.mobile_columns }};
    --featured-mobile-visible: {{ section.settings.mobile_visible }};
    --featured-desktop-peek: {{ section.settings.desktop_peek }}px;
    --featured-mobile-peek: {{ section.settings.mobile_peek }}px;
    --featured-columns: {{ section.settings.columns }};
    --featured-gap: {{ section.settings.gap }}px;
    --featured-image-ratio: {{ section.settings.image_ratio }};
    --featured-overlay-darkness: {{ resolved_darkness | divided_by: 100.0 }};
    --featured-overlay-alignment: {{ section.settings.overlay_alignment }};
    --featured-card-radius: {{ resolved_radius }}px;
    --featured-vignette-strength: {% if resolved_vignette == 'none' %}0{% elsif resolved_vignette == 'dramatic' %}0.65{% else %}0.35{% endif %};
  "
>
  <div class="{% if section.settings.full_width %}container-fluid{% else %}container{% endif %}">

    <div class="featured-collections__heading featured-collections__heading--{{ section.settings.heading_alignment }}{% if section.settings.use_heading_color_scheme %} color-{{ section.settings.heading_color_scheme }} featured-collections__heading--separate-scheme{% endif %}">
      <div class="featured-collections__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="featured-collections__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="featured-collections__title">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="featured-collections__description">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a class="featured-collections__view-all" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label | escape }}
          <span aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>

    {% if section.settings.show_arrows %}
      <div class="featured-collections__controls" data-featured-controls>
        <button
          type="button"
          class="featured-collections__arrow"
          data-featured-prev
          aria-label="Previous collections"
          aria-controls="FeaturedTrack-{{ section.id }}"
          disabled
        >&larr;</button>
        <button
          type="button"
          class="featured-collections__arrow"
          data-featured-next
          aria-label="Next collections"
          aria-controls="FeaturedTrack-{{ section.id }}"
          disabled
        >&rarr;</button>
      </div>
    {% endif %}

    <div
      id="FeaturedTrack-{{ section.id }}"
      class="featured-collections__grid"
      data-featured-track
      aria-label="Featured collections"
    >
      {% for block in section.blocks %}
        {% liquid
          assign collection = block.settings.collection
          assign image = block.settings.image
          if image == blank and collection != blank
            assign image = collection.image
          endif
          if image == blank and collection != blank
            assign image = collection.products.first.featured_image
          endif
        %}

        <div class="featured-collections__item{% if section.settings.use_card_color_scheme %} color-{{ section.settings.card_color_scheme }}{% endif %}" {{ block.shopify_attributes }}>
          {% render 'botanical-collection-card',
            collection: collection,
            image: image,
            title_override: block.settings.title,
            subtitle: block.settings.subtitle,
            show_count: section.settings.show_count,
            glass: section.settings.glass,
            glass_material: section.settings.glass_material,
            appearance: resolved_style,
            image_position: block.settings.image_position
          %}
        </div>
      {% else %}
        {% for i in (1..3) %}
          <div class="featured-collections__item{% if section.settings.use_card_color_scheme %} color-{{ section.settings.card_color_scheme }}{% endif %}">
            {% render 'botanical-collection-card',
              glass: section.settings.glass,
              glass_material: section.settings.glass_material,
            appearance: resolved_style
            %}
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collections",
  "tag": "section",
  "class": "featured-collections-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Content colors"
    },
    {
      "type": "checkbox",
      "id": "use_heading_color_scheme",
      "label": "Use separate heading color scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "heading_color_scheme",
      "label": "Heading color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_card_color_scheme",
      "label": "Use separate card color scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "EXPLORE THE GREENHOUSE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your kind of green."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>From rare tropicals to the seeds of your next adventure.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Optional link label",
      "default": "Explore all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Optional link destination"
    },
    {
      "type": "header",
      "content": "Responsive display"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile grid columns",
      "options": [
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "mobile_visible",
      "label": "Mobile carousel cards",
      "options": [
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "desktop_peek",
      "label": "Desktop next-card preview",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_peek",
      "label": "Mobile next-card preview",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show carousel arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full-width content",
      "default": false
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Card spacing",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "1",
          "label": "Square"
        },
        {
          "value": "0.8",
          "label": "Portrait"
        },
        {
          "value": "1.4",
          "label": "Landscape"
        }
      ],
      "default": "0.8"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "header",
      "content": "Card material"
    },
    {
      "type": "checkbox",
      "id": "glass",
      "label": "Use glass cards",
      "default": false
    },
    {
      "type": "select",
      "id": "glass_material",
      "label": "Glass material",
      "options": [
        {
          "value": "default",
          "label": "Global preset"
        },
        {
          "value": "clear",
          "label": "Clear"
        },
        {
          "value": "mist",
          "label": "Mist"
        },
        {
          "value": "cloudlight",
          "label": "Cloudlight"
        },
        {
          "value": "canopy",
          "label": "Canopy"
        }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Card appearance"
    },
    {
      "type": "select",
      "id": "card_appearance",
      "label": "Card style",
      "options": [
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "cinematic",
          "label": "Cinematic overlay"
        },
        {
          "value": "glass",
          "label": "Frosted glass overlay"
        }
      ],
      "default": "editorial"
    },
    {
      "type": "range",
      "id": "overlay_darkness",
      "label": "Overlay darkness",
      "min": 20,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 65
    },
    {
      "type": "select",
      "id": "overlay_alignment",
      "label": "Overlay text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "image_zoom",
      "label": "Zoom image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_global_card_settings",
      "label": "Use global card appearance",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Optional image override"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Optional title override"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Optional subtitle"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "top",
              "label": "Top"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
