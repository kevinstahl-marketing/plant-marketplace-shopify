{{ 'marketplace-header.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} {
    position: {% if section.settings.sticky_header %}sticky{% else %}relative{% endif %};
    top: {% if section.settings.sticky_header %}0{% else %}auto{% endif %};
    z-index: var(--z-header);
  }
{% endstyle %}

<header
  class="marketplace-header color-{{ section.settings.color_scheme }} header-layout--{{ section.settings.header_layout }} header-shadow--{{ section.settings.header_shadow }}{% unless section.settings.header_border %} header-no-border{% endunless %}"
  style="
    --brand-logo-width: {{ section.settings.logo_width }}px;
    --header-height: {{ section.settings.header_height }}px;
    --header-padding: {{ section.settings.header_padding }}px;
    --header-opacity: {{ section.settings.header_opacity | divided_by: 100.0 }};
  "
>
  <div class="header__branding">
    <a href="{{ routes.root_url }}" class="header__brand-link" aria-label="{{ shop.name | escape }} — Home">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 500
          | image_tag:
            class: 'header__logo',
            widths: '120, 180, 240, 360, 500',
            loading: 'eager',
            alt: shop.name
        }}
      {% else %}
        <span class="header__brand-mark" aria-hidden="true">✳</span>
        <span class="header__brand-name">{{ shop.name | escape }}</span>
      {% endif %}
    </a>
  </div>

  {% render 'header-mobile-menu', menu: section.settings.menu %}

  {% if section.settings.show_inline_search %}
    <div class="header__inline-search">
      {% render 'marketplace-search',
        context: 'header',
        placeholder: 'Search the marketplace',
        show_button: false
      %}
    </div>
  {% endif %}

  <nav class="header__menu" aria-label="Main navigation">
    {% for link in section.settings.menu.links %}
      {% if link.links.size > 0 %}
        <details class="header__dropdown">
          <summary class="header__dropdown-trigger">
            <span>{{ link.title | escape }}</span>
            <span class="header__chevron" aria-hidden="true"></span>
          </summary>

          <div class="header__dropdown-panel header__mega-menu">
            <div class="header__mega-content">
              <div class="header__mega-links">
                <div class="header__mega-heading">
                  <span class="header__mega-eyebrow">
                    THE BOTANICAL DIRECTORY
                  </span>
                  <h2>{{ link.title | escape }}</h2>
                  <a href="{{ link.url }}">Explore collection →</a>
                </div>

                <div class="header__mega-grid">
                  {% for child in link.links %}
                    <div class="header__mega-group">
                      <a class="header__mega-group-title"
                         href="{{ child.url }}">
                        {{ child.title | escape }}
                      </a>

                      {% for grandchild in child.links %}
                        <a class="header__mega-child"
                           href="{{ grandchild.url }}">
                          {{ grandchild.title | escape }}
                        </a>
                      {% endfor %}
                    </div>
                  {% endfor %}
                </div>
              </div>

              {% if section.settings.mega_image != blank %}
                <div class="header__mega-feature">
                  {{
                    section.settings.mega_image
                    | image_url: width: 700
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 500, 700',
                      alt: 'Botanical discovery'
                  }}
                  <div class="header__mega-feature-copy">
                    <span>EXPLORE THE COLLECTION</span>
                    <strong>
                      {{ section.settings.mega_heading | escape }}
                    </strong>
                  </div>
                </div>
              {% endif %}
            </div>
          </div>
        </details>
      {% else %}
        <a class="header__nav-link" href="{{ link.url }}">
          {{ link.title | escape }}
        </a>
      {% endif %}
    {% endfor %}
  </nav>

  <div class="header__icons">
    <a class="header__search-link"
       href="{{ routes.search_url }}"
       aria-label="Search marketplace">
      <svg viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.8"
           stroke-linecap="round" stroke-linejoin="round"
           aria-hidden="true">
        <circle cx="10.8" cy="10.8" r="7.3"></circle>
        <path d="m16.2 16.2 5 5"></path>
      </svg>
    </a>

    {% if shop.customer_accounts_enabled %}
      {{ 'icon-account.svg' | inline_asset_content | link_to: routes.account_url }}
    {% endif %}

    <a href="{{ routes.cart_url }}">
      {% if cart.item_count > 0 %}
        <sup>{{ cart.item_count }}</sup>
      {% endif %}

      {{ 'icon-cart.svg' | inline_asset_content }}
    </a>
  </div>
</header>



{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Store logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 40,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "image_picker",
      "id": "mega_image",
      "label": "Mega menu feature image"
    },
    {
      "type": "text",
      "id": "mega_heading",
      "label": "Mega menu feature heading",
      "default": "Explore the botanical world"
    },
    {
      "type": "header",
      "content": "Header appearance"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "Header layout",
      "options": [
        {
          "value": "balanced",
          "label": "Balanced"
        },
        {
          "value": "compact",
          "label": "Compact"
        }
      ],
      "default": "balanced"
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "Minimum header height",
      "min": 60,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 82
    },
    {
      "type": "range",
      "id": "header_padding",
      "label": "Horizontal padding",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "header_border",
      "label": "Show bottom border",
      "default": true
    },
    {
      "type": "select",
      "id": "header_shadow",
      "label": "Header shadow",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "strong",
          "label": "Strong"
        }
      ],
      "default": "subtle"
    },
    {
      "type": "range",
      "id": "header_opacity",
      "label": "Background opacity",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "checkbox",
      "id": "show_inline_search",
      "label": "Show inline desktop search",
      "default": false
    }
  ]
}
{% endschema %}
