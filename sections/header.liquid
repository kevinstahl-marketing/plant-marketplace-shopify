{{ 'header.css' | asset_url | stylesheet_tag }}

<header
  class="site-header full-width color-{{ section.settings.color_scheme }}{% if section.settings.glass %} site-header--glass glass-surface glass-surface--{{ section.settings.glass_material | default: 'default' }}{% endif %} site-header--width-{{ section.settings.content_width }}{% if section.settings.show_border %} site-header--border{% endif %} site-header--shadow-{{ section.settings.shadow }}"
  data-sticky="{{ section.settings.sticky }}"
  style="
    --header-height: {{ section.settings.header_height }}px;
    --brand-logo-width: {{ section.settings.logo_width }}px;
    --header-padding: {{ section.settings.horizontal_padding }}px;
    {% if section.settings.custom_glass %}--glass-opacity-override: {{ section.settings.glass_opacity }}%;{% endif %}
    {% if section.settings.custom_glass %}--glass-blur-override: {{ section.settings.glass_blur }}px;{% endif %}
  "
>
  <button
    class="header__menu-toggle"
    type="button"
    data-category-open
    aria-label="Open category navigation"
    aria-expanded="false"
    aria-controls="category-mobile-drawer"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16"/>
    </svg>
  </button>

  <div class="header__branding">
    <a href="{{ routes.root_url }}" class="header__brand-link"
       aria-label="{{ shop.name | escape }} — Home">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 520
          | image_tag:
            class: 'header__logo',
            widths: '100, 160, 240, 360, 520',
            loading: 'eager',
            alt: shop.name
        }}
      {% else %}
        <span class="header__brand-mark" aria-hidden="true">✳</span>
        <span class="header__brand-name">{{ shop.name | escape }}</span>
      {% endif %}
    </a>
  </div>

  {% if section.settings.show_search %}
    <div class="header__search">
      {% render 'search-form', context: 'header' %}
    </div>
  {% endif %}

  <div class="header__actions">
    <a class="header__mobile-search" href="{{ routes.search_url }}"
       aria-label="Search marketplace">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.7" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="7"/>
        <path d="m16 16 5 5"/>
      </svg>
    </a>

    {% if shop.customer_accounts_enabled %}
      <a href="{{ routes.account_url }}" aria-label="My account">
        {{ 'icon-account.svg' | inline_asset_content }}
      </a>
    {% endif %}

    <a href="{{ routes.cart_url }}" data-cart-link aria-label="Cart, {{ cart.item_count }} items">
      {{ 'icon-cart.svg' | inline_asset_content }}
      {% if cart.item_count > 0 %}
        <span class="header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      {% endif %}
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Main header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Store logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 40,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show predictive search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "glass",
      "label": "Frosted glass header",
      "default": true
    },
    {
      "type": "select",
      "id": "glass_material",
      "label": "Glass material",
      "options": [
        {
          "value": "default",
          "label": "Global default"
        },
        {
          "value": "clear",
          "label": "Clear"
        },
        {
          "value": "mist",
          "label": "Mist"
        },
        {
          "value": "cloudlight",
          "label": "Cloudlight"
        },
        {
          "value": "canopy",
          "label": "Canopy"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "Header height",
      "min": 60,
      "max": 110,
      "step": 2,
      "unit": "px",
      "default": 82
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Horizontal padding",
      "min": 12,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Glass and effects"
    },
    {
      "type": "checkbox",
      "id": "custom_glass",
      "label": "Use custom glass opacity and blur",
      "default": false
    },
    {
      "type": "range",
      "id": "glass_opacity",
      "label": "Glass opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "range",
      "id": "glass_blur",
      "label": "Glass blur",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Bottom border",
      "default": true
    },
    {
      "type": "select",
      "id": "shadow",
      "label": "Shadow",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "strong",
          "label": "Strong"
        }
      ],
      "default": "soft"
    },
    {
      "type": "header",
      "content": "Scroll behavior"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true
    }
  ]
}
{% endschema %}
