{{ 'marketplace-header.css' | asset_url | stylesheet_tag }}
{{ 'marketplace-header-layout.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    position: {% if section.settings.sticky_header %}sticky{% else %}relative{% endif %};
    top: {% if section.settings.sticky_header %}0{% else %}auto{% endif %};
    z-index: var(--z-header, 100);
  }
{% endstyle %}

<header
  class="marketplace-header marketplace-header--stacked color-{{ section.settings.color_scheme }} header-shadow--{{ section.settings.header_shadow }}{% unless section.settings.header_border %} header-no-border{% endunless %}"
  style="
    --brand-logo-width: {{ section.settings.logo_width }}px;
    --header-height: {{ section.settings.header_height }}px;
    --header-padding: {{ section.settings.header_padding }}px;
    --header-opacity: {{ section.settings.header_opacity | divided_by: 100.0 }};
  "
>
  <div class="marketplace-header__main-rail">
    <div class="marketplace-header__main-inner">

      {% render 'header-mobile-menu', menu: section.settings.menu %}

      <div class="header__branding">
        <a
          href="{{ routes.root_url }}"
          class="header__brand-link"
          aria-label="{{ shop.name | escape }} — Home"
        >
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 500
              | image_tag:
                class: 'header__logo',
                widths: '120, 180, 240, 360, 500',
                loading: 'eager',
                alt: shop.name
            }}
          {% else %}
            <span class="header__brand-mark" aria-hidden="true">✳</span>
            <span class="header__brand-name">{{ shop.name | escape }}</span>
          {% endif %}
        </a>
      </div>

      <div class="marketplace-header__search">
        {% render 'marketplace-search',
          context: 'header',
          placeholder: section.settings.search_placeholder,
          show_button: false
        %}
      </div>

      <div class="header__icons">
        {% if shop.customer_accounts_enabled %}
          <a href="{{ routes.account_url }}" aria-label="Account">
            {{ 'icon-account.svg' | inline_asset_content }}
          </a>
        {% endif %}

        <a href="{{ routes.cart_url }}" aria-label="Cart">
          {{ 'icon-cart.svg' | inline_asset_content }}
          {% if cart.item_count > 0 %}
            <sup>{{ cart.item_count }}</sup>
          {% endif %}
        </a>
      </div>

    </div>
  </div>

  {% if section.settings.show_category_rail %}
    <div class="marketplace-header__category-rail color-{{ section.settings.category_color_scheme }}">
      <div class="marketplace-header__category-inner">
        {% render 'header-primary-navigation',
          menu: section.settings.menu,
          mega_image: section.settings.mega_image,
          mega_heading: section.settings.mega_heading
        %}
      </div>
    </div>
  {% endif %}

  <div class="marketplace-header__mobile-search">
    {% render 'marketplace-search',
      context: 'mobile-header',
      placeholder: section.settings.search_placeholder,
      show_button: false
    %}
  </div>

</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Store logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 40,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "image_picker",
      "id": "mega_image",
      "label": "Mega menu feature image"
    },
    {
      "type": "text",
      "id": "mega_heading",
      "label": "Mega menu feature heading",
      "default": "Explore the botanical world"
    },
    {
      "type": "header",
      "content": "Header appearance"
    },
    {
      "type": "select",
      "id": "header_layout",
      "label": "Header layout",
      "options": [
        {
          "value": "balanced",
          "label": "Balanced"
        },
        {
          "value": "compact",
          "label": "Compact"
        }
      ],
      "default": "balanced"
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "Minimum header height",
      "min": 60,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 82
    },
    {
      "type": "range",
      "id": "header_padding",
      "label": "Horizontal padding",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "header_border",
      "label": "Show bottom border",
      "default": true
    },
    {
      "type": "select",
      "id": "header_shadow",
      "label": "Header shadow",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "subtle",
          "label": "Subtle"
        },
        {
          "value": "strong",
          "label": "Strong"
        }
      ],
      "default": "subtle"
    },
    {
      "type": "range",
      "id": "header_opacity",
      "label": "Background opacity",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "checkbox",
      "id": "show_inline_search",
      "label": "Show inline desktop search",
      "default": false
    },
    {
      "type": "header",
      "content": "Main and category rails"
    },
    {
      "type": "color_scheme",
      "id": "category_color_scheme",
      "label": "Category rail color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_category_rail",
      "label": "Show category navigation",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search plants, seeds, cultivars..."
    }
  ]
}
{% endschema %}
