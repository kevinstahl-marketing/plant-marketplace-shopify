{{ 'header.css' | asset_url | stylesheet_tag }}

<header
  class="site-header color-{{ section.settings.color_scheme }}{% if section.settings.glass %} site-header--glass{% endif %}"
  style="
    --header-height: {{ section.settings.header_height }}px;
    --brand-logo-width: {{ section.settings.logo_width }}px;
  "
>
  <button
    class="header__menu-toggle"
    type="button"
    data-category-open
    aria-label="Open category navigation"
    aria-expanded="false"
    aria-controls="category-mobile-drawer"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16"/>
    </svg>
  </button>

  <div class="header__branding">
    <a href="{{ routes.root_url }}" class="header__brand-link"
       aria-label="{{ shop.name | escape }} — Home">
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: 520
          | image_tag:
            class: 'header__logo',
            widths: '100, 160, 240, 360, 520',
            loading: 'eager',
            alt: shop.name
        }}
      {% else %}
        <span class="header__brand-mark" aria-hidden="true">✳</span>
        <span class="header__brand-name">{{ shop.name | escape }}</span>
      {% endif %}
    </a>
  </div>

  {% if section.settings.show_search %}
    <div class="header__search">
      {% render 'search-form', context: 'header' %}
    </div>
  {% endif %}

  <div class="header__actions">
    <a class="header__mobile-search" href="{{ routes.search_url }}"
       aria-label="Search marketplace">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="1.7" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="7"/>
        <path d="m16 16 5 5"/>
      </svg>
    </a>

    {% if shop.customer_accounts_enabled %}
      <a href="{{ routes.account_url }}" aria-label="My account">
        {{ 'icon-account.svg' | inline_asset_content }}
      </a>
    {% endif %}

    <a href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
      {{ 'icon-cart.svg' | inline_asset_content }}
      {% if cart.item_count > 0 %}
        <span class="header__cart-count">{{ cart.item_count }}</span>
      {% endif %}
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Main header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Store logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 40,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show predictive search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "glass",
      "label": "Frosted glass header",
      "default": true
    },
    {
      "type": "range",
      "id": "header_height",
      "label": "Header height",
      "min": 60,
      "max": 110,
      "step": 2,
      "unit": "px",
      "default": 82
    }
  ]
}
{% endschema %}
