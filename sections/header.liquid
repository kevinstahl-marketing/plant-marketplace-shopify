{{ 'marketplace-header.css' | asset_url | stylesheet_tag }}
{{ 'marketplace-header-layout.css' | asset_url | stylesheet_tag }}
{{ 'marketplace-header-appearance.css' | asset_url | stylesheet_tag }}
{{ 'marketplace-header-scroll.css' | asset_url | stylesheet_tag }}
{{ 'marketplace-navigation.css' | asset_url | stylesheet_tag }}
<script src="{{ 'marketplace-mobile-menu.js' | asset_url }}" defer></script>
<script src="{{ 'marketplace-header-scroll.js' | asset_url }}" defer></script>



<header
  data-nav-hover="{{ section.settings.nav_hover }}"
  data-nav-indicator="{{ section.settings.nav_indicator }}"
  data-nav-style="{{ section.settings.nav_style }}"
  data-scroll-reveal-on-hover="{{ section.settings.scroll_reveal_on_hover }}"
  data-scroll-close-mobile-menu="{{ section.settings.scroll_close_mobile_menu }}"
  data-scroll-travel="{{ section.settings.scroll_travel }}"
  data-scroll-easing="{{ section.settings.scroll_easing }}"
  data-scroll-visibility="{{ section.settings.scroll_visibility }}"
  data-scroll-sizing="{{ section.settings.scroll_sizing }}"
  data-scroll-animation="{{ section.settings.scroll_animation }}"
  data-scroll-speed="{{ section.settings.scroll_speed }}"
  data-scroll-threshold="{{ section.settings.scroll_threshold }}"
  data-scroll-reveal-distance="{{ section.settings.scroll_reveal_distance }}"
  data-scroll-hide-distance="{{ section.settings.scroll_hide_distance }}"
  data-scroll-reveal-near-top="{{ section.settings.scroll_reveal_near_top }}"
  data-scroll-protect-interactions="{{ section.settings.scroll_protect_interactions }}"

  data-scroll-hide-categories="{{ section.settings.scroll_hide_categories }}"
  class="marketplace-header marketplace-header--stacked float-material--{{ section.settings.float_material }} float-layout--{{ section.settings.float_layout }} float-shadow--{{ section.settings.float_shadow }} float-border--{{ section.settings.float_border }} color-{{ section.settings.color_scheme }} header-shadow--{{ section.settings.header_shadow }}{% unless section.settings.header_border %} header-no-border{% endunless %}"
  style="
    --float-blur: {{ section.settings.float_blur }}px;
    --float-opacity: {{ section.settings.float_opacity | divided_by: 100.0 }};
    --float-radius: {{ section.settings.float_radius }}px;
    --float-gap: {{ section.settings.float_gap }}px;
    --brand-logo-width: {{ section.settings.logo_width }}px;
    --header-height: {{ section.settings.header_height }}px;
    --header-padding: {{ section.settings.header_padding }}px;
    --header-opacity: {{ section.settings.header_opacity | divided_by: 100.0 }};
    --nav-font-size: {{ section.settings.nav_font_size }}px;
    --nav-gap: {{ section.settings.nav_gap }}px;
    --nav-radius: {{ section.settings.nav_radius }}px;
    --nav-padding-y: {{ section.settings.nav_vertical_padding }}px;
  "
>
  <div class="marketplace-header__main-rail">
    <div class="marketplace-header__main-inner">

      {% render 'header-mobile-menu', menu: section.settings.menu %}

      <div class="header__branding">
        <a
          href="{{ routes.root_url }}"
          class="header__brand-link"
          aria-label="{{ shop.name | escape }} — Home"
        >
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: 500
              | image_tag:
                class: 'header__logo',
                widths: '120, 180, 240, 360, 500',
                loading: 'eager',
                alt: shop.name
            }}
          {% else %}
            <span class="header__brand-mark" aria-hidden="true">✳</span>
            <span class="header__brand-name">{{ shop.name | escape }}</span>
          {% endif %}
        </a>
      </div>

      <div class="marketplace-header__search">
        {% render 'marketplace-search',
          context: 'header',
          placeholder: section.settings.search_placeholder,
          show_button: false
        %}
      </div>

      <div class="header__icons">
        {% if shop.customer_accounts_enabled %}
          <a href="{{ routes.account_url }}" aria-label="Account">
            {{ 'icon-account.svg' | inline_asset_content }}
          </a>
        {% endif %}

        <a href="{{ routes.cart_url }}" aria-label="Cart">
          {{ 'icon-cart.svg' | inline_asset_content }}
          {% if cart.item_count > 0 %}
            <sup>{{ cart.item_count }}</sup>
          {% endif %}
        </a>
      </div>

    </div>
  </div>

  {% if section.settings.show_category_rail %}
    <div class="marketplace-header__category-rail color-{{ section.settings.category_color_scheme }}">
      <div class="marketplace-header__category-inner">
        {% render 'header-primary-navigation',
          menu: section.settings.menu,
          mega_image: section.settings.mega_image,
          mega_heading: section.settings.mega_heading
        %}
      </div>
    </div>
  {% endif %}

  <div class="marketplace-header__mobile-search">
    {% render 'marketplace-search',
      context: 'mobile-header',
      placeholder: section.settings.search_placeholder,
      show_button: false
    %}
  </div>

</header>

{% schema %}
{
