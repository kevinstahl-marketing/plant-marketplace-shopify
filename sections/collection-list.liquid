  ],
  "presets": [
    {
      "name": "Collection list",
      "category": "Collections",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "heading": "Explore collections",
            "level": "h2"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Discover something worth growing.</p>"
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ]
}
{% endschema %}
