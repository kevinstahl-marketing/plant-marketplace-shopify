    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "material",
      "label": "Card material",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "default",
          "label": "Global glass"
        },
        {
          "value": "clear",
          "label": "Clear"
        },
        {
          "value": "mist",
          "label": "Mist"
        },
        {
          "value": "cloudlight",
          "label": "Cloudlight"
        },
        {
          "value": "canopy",
          "label": "Canopy"
        },
        {
          "value": "shelter",
          "label": "Shelter"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Section appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum content width",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
