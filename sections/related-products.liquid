    {
      "type": "color_scheme",
      "id": "heading_color_scheme",
      "label": "Heading color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_card_color_scheme",
      "label": "Use separate card color scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "KEEP EXPLORING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You might also love"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Maximum products",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Responsive display"
