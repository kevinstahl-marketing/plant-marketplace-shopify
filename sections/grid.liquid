{{ 'grid.css' | asset_url | stylesheet_tag }}

<div
  class="theme-grid-section full-width color-{{ section.settings.color_scheme }}"
  style="
    --grid-section-width: {{ section.settings.max_width }}px;
    --grid-section-padding: {{ section.settings.padding }}px;
    --grid-section-mobile-padding: {{ section.settings.mobile_padding }}px;
  "
>
  <div
    class="theme-grid"
    style="
      --grid-columns: {{ section.settings.columns }};
      --grid-tablet-columns: {{ section.settings.tablet_columns }};
      --grid-mobile-columns: {{ section.settings.mobile_columns }};
      --grid-gap: {{ section.settings.gap }}px;
      --grid-mobile-gap: {{ section.settings.mobile_gap }}px;
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Grid",
  "tag": "section",
  "class": "section-grid",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "label": "Tablet columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Section size"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Vertical padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile vertical padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Grid",
      "category": "Layout"
    }
  ]
}
{% endschema %}
