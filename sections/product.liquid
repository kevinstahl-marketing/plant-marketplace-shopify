{{ 'product-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-page.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
%}

{% liquid
  case section.settings.gallery_ratio
    when 'portrait'
      assign gallery_ratio = '3 / 4'
    when 'landscape'
      assign gallery_ratio = '4 / 3'
    else
      assign gallery_ratio = '1 / 1'
  endcase
%}

<section
  class="product-page color-{{ section.settings.color_scheme }}"
  style="
    --product-page-gap: {{ section.settings.column_gap }}px;
    --product-block-gap: {{ section.settings.block_gap }}px;
    --product-arrow-size: {{ section.settings.gallery_arrow_size }}px;
    --product-dot-size: {{ section.settings.gallery_dot_size }}px;
    --product-dot-gap: {{ section.settings.gallery_dot_gap }}px;
    --product-dot-active-ratio: {% if section.settings.gallery_dot_style == 'circle' %}1{% else %}2.4{% endif %};
    --product-page-padding-top: {{ section.settings.padding_top }}px;
    --product-page-padding-bottom: {{ section.settings.padding_bottom }}px;
    --product-gallery-share: {{ section.settings.gallery_width }}%;
    --product-gallery-max-width: {{ section.settings.gallery_max_width }}px;
    --product-gallery-max-height: {{ section.settings.gallery_max_height }}px;
    --product-gallery-ratio: {{ gallery_ratio }};
    --product-gallery-fit: {{ section.settings.gallery_fit }};
    --product-gallery-radius: {{ section.settings.gallery_radius }}px;
    --product-thumbnail-size: {{ section.settings.thumbnail_size }}px;
  "
  data-product-page
>
  <div class="container product-page__layout">
    <div class="product-page__media">
      <div class="product-page__gallery-frame">
      {% render 'product-gallery', product: product, section: section %}
      </div>
    </div>

    <div class="product-page__information{% if section.settings.sticky_info %} product-page__information--sticky{% endif %}">
      {% form 'product', product, id: product_form_id, class: 'product-page__form' %}
        <input
          type="hidden"
          name="id"
          value="{{ current_variant.id }}"
          data-product-variant-id
        >

        <div class="product-page__blocks">
          {% for block in section.blocks %}
            {% case block.type %}
            {% when 'product-vendor' %}
              {% if product.vendor != blank %}
                <p class="product-page__vendor" {{ block.shopify_attributes }}>
                  {{ product.vendor | escape }}
                </p>
              {% endif %}
            {% when 'product-title' %}
              <h1 class="product-page__title" {{ block.shopify_attributes }}>
                {{ product.title | escape }}
              </h1>
            {% when 'product-price' %}
              <div class="product-page__price" {{ block.shopify_attributes }}>
                <span data-product-price>{{ current_variant.price | money }}</span>
                <s data-product-compare-price
                  {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>
                  {{ current_variant.compare_at_price | money }}
                </s>
              </div>
            {% when 'product-description' %}
              {% if product.description != blank %}
                <div class="product-page__description rte" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>
              {% endif %}
            {% when 'product-variants' %}
              {% unless product.has_only_default_variant %}
                <div class="product-page__field" {{ block.shopify_attributes }}>
                  <label for="ProductVariants-{{ section.id }}">
                    {{ block.settings.label | escape }}
                  </label>
                  <select
                    id="ProductVariants-{{ section.id }}"
                    class="ui-input product-page__variant-select"
                    data-product-variant-select
                  >
                    {% for variant in product.variants %}
                      <option
                        value="{{ variant.id }}"
                        {% if variant.id == current_variant.id %}selected{% endif %}
                        {% unless variant.available %}disabled{% endunless %}
                      >
                        {{ variant.title | escape }}
                        {% unless variant.available %} — Sold out{% endunless %}
                      </option>
                    {% endfor %}
                  </select>
                </div>
              {% endunless %}
            {% when 'product-quantity' %}
              <div class="product-page__field" {{ block.shopify_attributes }}>
                <label for="ProductQuantity-{{ section.id }}">Quantity</label>
                <input
                  id="ProductQuantity-{{ section.id }}"
                  class="ui-input product-page__quantity"
                  type="number"
                  name="quantity"
                  value="1"
                  min="1"
                  step="1"
                  inputmode="numeric"
                >
              </div>
            {% when 'product-inventory' %}
              <div class="product-page__inventory" {{ block.shopify_attributes }}>
                <span data-product-inventory aria-live="polite">
                  {% if current_variant.available %}In stock{% else %}Sold out{% endif %}
                </span>
              </div>
            {% when 'product-buy' %}
              <div class="product-page__buy-buttons" {{ block.shopify_attributes }}>
                <button
                  type="submit"
                  name="add"
                  class="ui-button ui-button--primary product-page__add-to-cart"
                  data-product-add
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span data-product-add-label>
                    {% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}
                  </span>
                </button>
              </div>
            {% endcase %}
          {% endfor %}
        </div>

        {% if section.settings.show_dynamic_checkout %}
          <div class="product-page__dynamic-checkout">
            {{ form | payment_button }}
          </div>
        {% endif %}

        <script type="application/json" data-product-variants>
          {{ product.variants | json }}
        </script>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "header",
      "content": "Product layout"
    },
    {
      "type": "range",
      "id": "gallery_width",
      "label": "Gallery column width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column spacing",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "block_gap",
      "label": "Product information spacing",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "sticky_info",
      "label": "Sticky product information",
      "default": false
    },
    {
      "type": "header",
      "content": "Product gallery"
    },
    {
      "type": "select",
      "id": "gallery_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "gallery_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "cover",
          "label": "Cover"
        }
      ],
      "default": "contain"
    },
    {
      "type": "range",
      "id": "gallery_max_width",
      "label": "Maximum gallery width",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "gallery_max_height",
      "label": "Maximum image height",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "header",
      "content": "Gallery navigation"
    },
    {
      "type": "checkbox",
      "id": "gallery_show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "gallery_arrow_visibility",
      "label": "Arrow visibility",
      "options": [
        {
          "value": "hover",
          "label": "On hover"
        },
        {
          "value": "always",
          "label": "Always"
        }
      ],
      "default": "hover"
    },
    {
      "type": "range",
      "id": "gallery_arrow_size",
      "label": "Arrow size",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "gallery_show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "range",
      "id": "gallery_dot_size",
      "label": "Dot size",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "px",
      "default": 5
    },
    {
      "type": "range",
      "id": "gallery_dot_gap",
      "label": "Dot spacing",
      "min": 4,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "select",
      "id": "gallery_dot_style",
      "label": "Active dot style",
      "options": [
        {
          "value": "pill",
          "label": "Pill"
        },
        {
          "value": "circle",
          "label": "Circle"
        }
      ],
      "default": "pill"
    },
    {
      "type": "select",
      "id": "thumbnail_position",
      "label": "Thumbnail position",
      "options": [
        {
          "value": "bottom",
          "label": "Below"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "range",
      "id": "thumbnail_size",
      "label": "Thumbnail size",
      "min": 48,
      "max": 112,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "gallery_radius",
      "label": "Gallery corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Section appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show accelerated checkout",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "product-vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": []
    },
    {
      "type": "product-title",
      "name": "Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "product-price",
      "name": "Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "product-description",
      "name": "Description",
      "limit": 1,
      "settings": []
    },
    {
      "type": "product-variants",
      "name": "Variants",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Choose an option"
        }
      ]
    },
    {
      "type": "product-quantity",
      "name": "Quantity",
      "limit": 1,
      "settings": []
    },
    {
      "type": "product-inventory",
      "name": "Inventory",
      "limit": 1,
      "settings": []
    },
    {
      "type": "product-buy",
      "name": "Buy",
      "limit": 1,
      "settings": []
    }
  ]
}
{% endschema %}
