<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {{ 'tokens.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'controls.css' | asset_url | stylesheet_tag }}
    {{ 'global.css' | asset_url | stylesheet_tag }}
    {{ 'block-layout.css' | asset_url | stylesheet_tag }}
    {{ 'greenhouse.css' | asset_url | stylesheet_tag }}
    {{ 'glass.css' | asset_url | stylesheet_tag }}
    {{ 'card.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
    <script src="{{ 'greenhouse.js' | asset_url }}" defer></script>
  </head>

  <body
    class="color-scheme-1"
    data-atmosphere="{{ settings.greenhouse_atmosphere | default: 'day' }}"
    data-glass="{{ settings.greenhouse_glass | default: 'mist' }}"
  >
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
  </body>
</html>
