{% comment %}
  Utility rail.
  Uses Shopify color schemes and native navigation.
  settings: parent header section settings.
{% endcomment %}

<div class="marketplace-utility color-{{ settings.utility_color_scheme }}">
  <div class="marketplace-utility__inner">

    <div class="marketplace-utility__message">
      {{ settings.utility_message | escape }}
    </div>

    <nav class="marketplace-utility__links"
         aria-label="Utility navigation">

      {% if settings.utility_menu != blank %}
        {% for link in settings.utility_menu.links %}
          <a href="{{ link.url }}">
            {{ link.title | escape }}
          </a>
        {% endfor %}
      {% endif %}

      {% if settings.utility_show_account and shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}">
          Account
        </a>
      {% endif %}

    </nav>
  </div>
</div>
