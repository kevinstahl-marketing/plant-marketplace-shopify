{% liquid
  assign layout = 'editorial'
  assign eyebrow = 'THE BOTANICAL DIRECTORY'
  assign heading = link.title
  assign description = blank
  assign cta_label = blank
  assign cta_url = link.url
  assign image = mega_image
  assign image_position = 'right'
  assign image_ratio = 'portrait'
  assign columns = 3
  assign surface = 'solid'
  assign border = 'hairline'
  assign radius = 16
  assign shadow = 'soft'
  assign animation = 'fade'
  assign speed = 'smooth'

  if mega_block != blank
    assign layout = mega_block.settings.layout
    assign eyebrow = mega_block.settings.eyebrow
    assign description = mega_block.settings.description
    assign cta_label = mega_block.settings.cta_label
    assign image = mega_block.settings.image
    assign image_position = mega_block.settings.image_position
    assign image_ratio = mega_block.settings.image_ratio
    assign columns = mega_block.settings.columns
    assign surface = mega_block.settings.surface
    assign border = mega_block.settings.border
    assign radius = mega_block.settings.radius
    assign shadow = mega_block.settings.shadow
    assign animation = mega_block.settings.animation
    assign speed = mega_block.settings.speed

    if mega_block.settings.heading != blank
      assign heading = mega_block.settings.heading
    endif

    if mega_block.settings.cta_url != blank
      assign cta_url = mega_block.settings.cta_url
    endif
  endif
%}

<div
  class="header__dropdown-panel header__mega-menu mega-layout--{{ layout }} mega-surface--{{ surface }} mega-border--{{ border }} mega-shadow--{{ shadow }} mega-image--{{ image_position }} mega-ratio--{{ image_ratio }}"
  data-mega-animation="{{ animation }}"
  data-mega-speed="{{ speed }}"
  style="--mega-columns: {{ columns }}; --mega-radius: {{ radius }}px;"
  {% if mega_block != blank %}
    {{ mega_block.shopify_attributes }}
  {% endif %}
>
  <div class="header__mega-content">

    <div class="header__mega-links">
      <div class="header__mega-heading">

        {% if eyebrow != blank %}
          <span class="header__mega-eyebrow">
            {{ eyebrow | escape }}
          </span>
        {% endif %}

        <h2>{{ heading | escape }}</h2>

        {% if description != blank %}
          <p class="mega-description">
            {{ description | escape }}
          </p>
        {% endif %}

        {% if cta_label != blank %}
          <a class="mega-cta" href="{{ cta_url }}">
            {{ cta_label | escape }}
          </a>
        {% else %}
          <a class="mega-cta" href="{{ link.url }}">
            Explore {{ link.title | escape }}
          </a>
        {% endif %}
      </div>

      <div class="header__mega-grid">
        {% for child in link.links %}
          <div class="header__mega-group">
            <a
              class="header__mega-group-title"
              href="{{ child.url }}"
            >
              {{ child.title | escape }}
            </a>

            {% for grandchild in child.links %}
              <a
                class="header__mega-child"
                href="{{ grandchild.url }}"
              >
                {{ grandchild.title | escape }}
              </a>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>

    {% unless layout == 'directory' %}
      {% if image != blank %}
        <div class="header__mega-feature">
          {{
            image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '320, 480, 700, 1000',
              alt: heading
          }}

          <div class="header__mega-feature-copy">
            <span>{{ eyebrow | escape }}</span>
            <strong>{{ heading | escape }}</strong>
          </div>
        </div>
      {% endif %}
    {% endunless %}

  </div>
</div>
