{% liquid
  assign card_title = title_override
  if card_title == blank and collection != blank
    assign card_title = collection.title
  endif
  if card_title == blank
    assign card_title = 'Choose a collection'
  endif

  assign card_url = ''
  if collection != blank
    assign card_url = collection.url
  endif

  assign position = image_position | default: 'center'
%}

{% capture card_classes %}
  botanical-collection-card
  {% if glass %}glass-surface glass-surface--{{ glass_material | default: 'default' }}{% endif %}
{% endcapture %}

{% if card_url != blank %}
  <a href="{{ card_url }}" class="{{ card_classes | strip }}" style="--card-image-position: {{ position }};">
{% else %}
  <div class="{{ card_classes | strip }}" style="--card-image-position: {{ position }};">
{% endif %}

  <div class="botanical-collection-card__media">
    {% if image != blank %}
      {{
        image
        | image_url: width: 1200
        | image_tag:
          class: 'botanical-collection-card__image',
          loading: 'lazy',
          widths: '320, 480, 640, 800, 1200',
          sizes: '(min-width: 990px) 33vw, (min-width: 600px) 50vw, 100vw'
      }}
    {% else %}
      {{ 'collection-1' | placeholder_svg_tag: 'botanical-collection-card__placeholder' }}
    {% endif %}
  </div>

  <div class="botanical-collection-card__content">
    <div>
      <h3 class="botanical-collection-card__title">
        {{ card_title | escape }}
      </h3>

      {% if subtitle != blank %}
        <p class="botanical-collection-card__subtitle">
          {{ subtitle | escape }}
        </p>
      {% endif %}

      {% if show_count and collection != blank %}
        <p class="botanical-collection-card__count">
          {{ collection.all_products_count }}
          {% if collection.all_products_count == 1 %}
            product
          {% else %}
            products
          {% endif %}
        </p>
      {% endif %}
    </div>

    {% if card_url != blank %}
      <span class="botanical-collection-card__arrow" aria-hidden="true">&rarr;</span>
    {% endif %}
  </div>

{% if card_url != blank %}
  </a>
{% else %}
  </div>
{% endif %}
