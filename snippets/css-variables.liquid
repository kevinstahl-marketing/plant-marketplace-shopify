{% style %}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-heading--family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    --font-heading--weight: {{ settings.type_heading_font.weight }};
    --body-font-size: {{ settings.body_font_size }}px;
    --heading-letter-spacing: {{ settings.heading_letter_spacing }}px;
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --control-button-radius: {% case settings.button_shape %}
      {% when 'square' %}0px
      {% when 'rounded' %}14px
      {% when 'pill' %}9999px
      {% else %}6px
    {% endcase %};
    --control-button-height: {% case settings.button_height %}
      {% when 'compact' %}36px
      {% when 'large' %}52px
      {% else %}44px
    {% endcase %};
    --control-button-border-width: {% if settings.button_border == 'subtle' %}1px{% else %}2px{% endif %};
    --control-input-radius: {{ settings.input_corner_radius }}px;

  }

  {% for scheme in settings.color_schemes %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background }};
      --color-foreground: {{ scheme.settings.foreground }};
      --color-primary: {{ scheme.settings.primary }};
      --color-accent: {{ scheme.settings.accent }};
      --color-surface: {{ scheme.settings.surface }};
      --color-surface-muted: {{ scheme.settings.surface_muted }};
      --color-text: {{ scheme.settings.foreground }};
      --color-text-muted: {{ scheme.settings.text_muted }};
      --color-border: {{ scheme.settings.border }};
      --color-primary-dark: {{ scheme.settings.primary | color_darken: 12 }};

    }
  {% endfor %}

  /* Centrally configured glass materials */
  :root {
    --glass-clear-opacity: {{ settings.glass_clear_opacity | default: 22 }}%;
    --glass-clear-blur: {{ settings.glass_clear_blur | default: 8 }}px;
    --glass-clear-border: {{ settings.glass_clear_border | default: 12 }}%;
    --glass-mist-opacity: {{ settings.glass_mist_opacity | default: 48 }}%;
    --glass-mist-blur: {{ settings.glass_mist_blur | default: 18 }}px;
    --glass-mist-border: {{ settings.glass_mist_border | default: 16 }}%;
    --glass-cloudlight-opacity: {{ settings.glass_cloudlight_opacity | default: 78 }}%;
    --glass-cloudlight-blur: {{ settings.glass_cloudlight_blur | default: 24 }}px;
    --glass-cloudlight-border: {{ settings.glass_cloudlight_border | default: 18 }}%;
    --glass-canopy-opacity: {{ settings.glass_canopy_opacity | default: 92 }}%;
    --glass-canopy-blur: {{ settings.glass_canopy_blur | default: 24 }}px;
    --glass-canopy-border: {{ settings.glass_canopy_border | default: 24 }}%;
    --glass-shelter-opacity: {{ settings.glass_shelter_opacity | default: 96 }}%;
    --glass-shelter-blur: {{ settings.glass_shelter_blur | default: 20 }}px;
    --glass-shelter-border: {{ settings.glass_shelter_border | default: 18 }}%;
  }

{% endstyle %}
