[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#FAFAF6"
          },
          {
            "type": "color",
            "id": "foreground",
            "label": "Text",
            "default": "#202B24"
          },
          {
            "type": "color",
            "id": "primary",
            "label": "Primary",
            "default": "#285943"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent",
            "default": "#B8D69A"
          },
          {
            "type": "color",
            "id": "surface",
            "label": "Surface",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "surface_muted",
            "label": "Muted surface",
            "default": "#EDF2E9"
          },
          {
            "type": "color",
            "id": "text_muted",
            "label": "Muted text",
            "default": "#637067"
          },
          {
            "type": "color",
            "id": "border",
            "label": "Borders",
            "default": "#DCE3D9"
          }
        ],
        "role": {
          "background": "background",
          "text": "foreground",
          "links": "primary",
          "icons": "foreground",
          "primary_button": "primary",
          "on_primary_button": "background",
          "primary_button_border": "primary",
          "secondary_button": "background",
          "on_secondary_button": "foreground",
          "secondary_button_border": "border"
        }
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "Input corner radius",
        "default": 4
      }
    ]
  }
]
